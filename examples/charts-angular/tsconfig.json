{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@tanstack/charts/angular/server": [
        "../../packages/charts-core/src/angular-server.ts"
      ],
      "@tanstack/charts/angular/canvas": [
        "../../packages/charts-core/src/angular-canvas.ts"
      ],
      "@tanstack/angular-charts": ["../../packages/angular-charts/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  }
}
